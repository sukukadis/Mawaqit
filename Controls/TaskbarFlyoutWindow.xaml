<Window x:Class="Mawaqit.Controls.TaskbarFlyoutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Mawaqit"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        Width="388"
        SizeToContent="Height"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display">

    <Grid Margin="10" HorizontalAlignment="Center">
        <Border x:Name="FlyoutBorder"
                Width="368"
                CornerRadius="12"
                BorderThickness="1"
                Background="#2B2B2B"
                BorderBrush="#3A3A3A">
            <Border.Effect>
                <DropShadowEffect x:Name="FlyoutShadow" BlurRadius="28" ShadowDepth="5" Direction="270" Opacity="0.45" Color="#000000"/>
            </Border.Effect>

            <StackPanel Margin="0">
                <!-- HEADER: TITLE + ACTION ICONS -->
                <Grid Margin="18,14,18,6">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Image x:Name="ImgFlyoutLogo" Width="22" Height="22" Margin="0,0,8,0"
                               RenderOptions.BitmapScalingMode="HighQuality" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TxtAppTitle" Text="Mawaqit" 
                                   FontSize="16.5" FontWeight="Bold" Foreground="#10B981"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <!-- Settings Button -->
                        <Button x:Name="BtnSettings" ToolTip="Settings" Width="30" Height="30"
                                Background="Transparent" BorderThickness="0" Cursor="Hand"
                                Click="BtnSettings_Click">
                            <TextBlock x:Name="TxtBtnSettings" Text="⚙" FontSize="15" Foreground="#A0A0A0" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>

                        <!-- Refresh Button -->
                        <Button x:Name="BtnRefresh" ToolTip="Refresh" Width="30" Height="30" Margin="4,0,0,0"
                                Background="Transparent" BorderThickness="0" Cursor="Hand"
                                Click="BtnRefresh_Click">
                            <TextBlock x:Name="TxtBtnRefresh" Text="🔄" FontSize="14" Foreground="#A0A0A0" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>

                        <!-- About Button -->
                        <Button x:Name="BtnAbout" ToolTip="About" Width="30" Height="30" Margin="4,0,0,0"
                                Background="Transparent" BorderThickness="0" Cursor="Hand"
                                Click="BtnAbout_Click">
                            <TextBlock x:Name="TxtBtnAbout" Text="ⓘ" FontSize="15" FontWeight="Bold" Foreground="#A0A0A0" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- DATE, LOCATION & WEATHER BLOCK -->
                <StackPanel Margin="0,6,0,10" HorizontalAlignment="Center">
                    <TextBlock x:Name="TxtDayOfWeek" Text="Wednesday" 
                               FontSize="14" Foreground="#A0A0A0" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="TxtHijriDate" Text="25 Rajab 1447" 
                               FontSize="16.5" FontWeight="SemiBold" Foreground="#FFFFFF" Margin="0,3,0,3" HorizontalAlignment="Center"/>
                    <!-- Location & Colorful Windows 11 Weather -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtLocation" Text="Collo — Algeria" 
                                   FontSize="13.5" Foreground="#A0A0A0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TxtWeatherDot" Text="  •  " 
                                   FontSize="13.5" Foreground="#64748B" VerticalAlignment="Center" Visibility="Collapsed"/>
                        <Image x:Name="ImgFlyoutWeather" Width="18" Height="18" Margin="0,0,5,0" 
                               VerticalAlignment="Center" Visibility="Collapsed"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                        <TextBlock x:Name="TxtFlyoutTemp" Text="" 
                                   FontSize="13.5" FontWeight="SemiBold" Foreground="#E2E8F0" VerticalAlignment="Center" Visibility="Collapsed"/>
                        <TextBlock x:Name="TxtLocationWeather" Text="" Visibility="Collapsed"/>
                    </StackPanel>
                </StackPanel>

                <!-- PRAYER TIMES LIST -->
                <StackPanel x:Name="PrayerListPanel" Margin="16,0,16,8">
                    <!-- Fajr Row -->
                    <Grid x:Name="RowFajr" Height="38" Margin="4,2">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="IconFajr" Text="✓" Width="24" FontSize="14" Foreground="#A0A0A0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="NameFajr" Text="Fajr" FontSize="15" FontWeight="SemiBold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock x:Name="TimeFajr" Text="06:15" FontSize="15.5" FontFamily="Segoe UI, Consolas, monospace" FontWeight="SemiBold" Foreground="#FFFFFF" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>

                    <!-- Shuruq Row -->
                    <Grid x:Name="RowShuruq" Height="38" Margin="4,2">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="IconShuruq" Text="✓" Width="24" FontSize="14" Foreground="#A0A0A0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="NameShuruq" Text="Shuruq" FontSize="15" FontWeight="SemiBold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock x:Name="TimeShuruq" Text="07:46" FontSize="15.5" FontFamily="Segoe UI, Consolas, monospace" FontWeight="SemiBold" Foreground="#FFFFFF" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>

                    <!-- Dhuhr Row -->
                    <Grid x:Name="RowDhuhr" Height="38" Margin="4,2">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="IconDhuhr" Text="✓" Width="24" FontSize="14" Foreground="#A0A0A0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="NameDhuhr" Text="Dhuhr" FontSize="15" FontWeight="SemiBold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock x:Name="TimeDhuhr" Text="12:43" FontSize="15.5" FontFamily="Segoe UI, Consolas, monospace" FontWeight="SemiBold" Foreground="#FFFFFF" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>

                    <!-- Active/Next Prayer Highlight Card (Emerald Green matching app interface) -->
                    <Border x:Name="CardActivePrayer" CornerRadius="8" Background="#10B981" Height="44" Padding="12,0" Margin="0,3">
                        <Grid VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock x:Name="IconActive" Text="🕒" Width="24" FontSize="15" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                                <TextBlock x:Name="NameActive" Text="Asr" FontSize="15.5" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                            </StackPanel>

                            <Button x:Name="BtnDismiss" Content="Dismiss" 
                                    Background="Transparent" BorderThickness="0" 
                                    Foreground="#FFFFFF" FontSize="12.5" FontWeight="SemiBold" 
                                    Cursor="Hand" HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Visibility="Collapsed" Click="BtnDismiss_Click"/>

                            <TextBlock x:Name="TimeActive" Text="15:20" FontSize="16" FontWeight="Bold" FontFamily="Segoe UI, Consolas, monospace" Foreground="#FFFFFF" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- Maghrib Row -->
                    <Grid x:Name="RowMaghrib" Height="38" Margin="4,2">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="IconMaghrib" Text="🕒" Width="24" FontSize="14" Foreground="#A0A0A0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="NameMaghrib" Text="Maghrib" FontSize="15" FontWeight="SemiBold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock x:Name="TimeMaghrib" Text="17:40" FontSize="15.5" FontFamily="Segoe UI, Consolas, monospace" FontWeight="SemiBold" Foreground="#FFFFFF" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>

                    <!-- Isha Row -->
                    <Grid x:Name="RowIsha" Height="38" Margin="4,2">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="IconIsha" Text="🕒" Width="24" FontSize="14" Foreground="#A0A0A0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="NameIsha" Text="Isha" FontSize="15" FontWeight="SemiBold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock x:Name="TimeIsha" Text="19:06" FontSize="15.5" FontFamily="Segoe UI, Consolas, monospace" FontWeight="SemiBold" Foreground="#FFFFFF" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                </StackPanel>

                <!-- HIGH-CONTRAST READABLE QURANIC VERSE & REFERENCE -->
                <Border x:Name="VerseBorder" Margin="16,8,16,14" Padding="14,10" 
                        Background="#333333" CornerRadius="8" 
                        BorderThickness="1" BorderBrush="#3A3A3A">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock x:Name="TxtVerse"
                                   Text="إِنَّ الصَّلَاةَ كَانَتْ عَلَى الْمُؤْمِنِينَ كِتَابًا مَوْقُوتًا" 
                                   FontSize="17.5" FontWeight="SemiBold"
                                   FontFamily="Amiri, Traditional Arabic, Arabic Typesetting, Segoe UI" 
                                   Foreground="#FFFFFF" HorizontalAlignment="Center" TextAlignment="Center"
                                   TextWrapping="Wrap"/>
                        <TextBlock x:Name="TxtCitation"
                                   Text="[النساء: 103]" 
                                   FontSize="13" FontWeight="Normal"
                                   FontFamily="Segoe UI, Tahoma, sans-serif" 
                                   Foreground="#A0A0A0" HorizontalAlignment="Center" TextAlignment="Center" 
                                   Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>
    </Grid>
</Window>
