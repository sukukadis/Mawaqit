<Window x:Class="Mawaqit.Controls.TaskbarWidgetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Mawaqit Taskbar Widget"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        Focusable="False">

    <Window.Resources>
        <Style x:Key="WidgetContextMenu" TargetType="ContextMenu">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border x:Name="MenuBorder" CornerRadius="8" BorderThickness="1" Background="#E8131C26" BorderBrush="#2B374A" Padding="4,6">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="16" ShadowDepth="4" Direction="270" Opacity="0.35" Color="#000000"/>
                            </Border.Effect>
                            <StackPanel IsItemsHost="True"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WidgetMenuItem" TargetType="MenuItem">
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="8,2"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#CBD5E1"/>
            <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI, sans-serif"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="ItemBorder" CornerRadius="6" Background="Transparent" Padding="{TemplateBinding Padding}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="22"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ContentPresenter Grid.Column="0" ContentSource="Icon" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                <TextBlock Grid.Column="0" x:Name="CheckMark" Text="✓" FontWeight="Bold" FontSize="11" 
                                           HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                                <ContentPresenter Grid.Column="1" ContentSource="Header" VerticalAlignment="Center" Margin="4,0,12,0"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#2510B981"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WidgetSeparator" TargetType="Separator">
            <Setter Property="Margin" Value="6,4"/>
            <Setter Property="Height" Value="1"/>
            <Setter Property="Background" Value="#2A374A"/>
        </Style>
    </Window.Resources>

    <Grid Margin="0" Width="120" Height="36">
        <!-- Notification / Alert Indicator (Accent fill pill when near or entered, matching app interface) -->
        <Border x:Name="NotificationIndicator"
                CornerRadius="4"
                Background="#10B981"
                Opacity="0"
                IsHitTestVisible="False"/>

        <!-- Subtle Windows Taskbar Hover Highlight -->
        <Border x:Name="HoverIndicator"
                CornerRadius="4"
                Background="Transparent"
                IsHitTestVisible="False"/>

        <!-- Main Interactive Button Surface -->
        <Border x:Name="RootBorder"
                CornerRadius="4"
                BorderThickness="0"
                Background="Transparent"
                Cursor="Hand"
                ToolTip="{x:Null}"
                ToolTipService.IsEnabled="False"
                PreviewMouseLeftButtonDown="RootBorder_PreviewMouseLeftButtonDown"
                PreviewMouseLeftButtonUp="RootBorder_PreviewMouseLeftButtonUp"
                MouseMove="RootBorder_MouseMove"
                MouseEnter="RootBorder_MouseEnter"
                MouseLeave="RootBorder_MouseLeave">

            <Border.ContextMenu>
                <ContextMenu x:Name="WidgetMenu" Style="{StaticResource WidgetContextMenu}">
                    <MenuItem x:Name="MenuNextMonitor" Header="🖥️ نقل إلى الشاشة التالية" 
                              Style="{StaticResource WidgetMenuItem}" Click="MenuNextMonitor_Click"/>
                    <Separator Style="{StaticResource WidgetSeparator}"/>
                    <MenuItem x:Name="MenuLockTaskbar" Header="🔒 قفل بجانب علبة النظام (افتراضي)" IsCheckable="True" IsChecked="True"
                              Style="{StaticResource WidgetMenuItem}" Click="MenuLockTaskbar_Click"/>
                    <MenuItem x:Name="MenuShowSeconds" Header="⏱️ إظهار الثواني" IsCheckable="True"
                              Style="{StaticResource WidgetMenuItem}" Click="MenuShowSeconds_Click"/>
                    <Separator Style="{StaticResource WidgetSeparator}"/>
                    <MenuItem x:Name="MenuSettings" Header="⚙️ الإعدادات…" 
                              Style="{StaticResource WidgetMenuItem}" Click="MenuSettings_Click"/>
                    <MenuItem x:Name="MenuHide" Header="👁 إخفاء ودجت شريط المهام" 
                              Style="{StaticResource WidgetMenuItem}" Click="MenuHide_Click"/>
                    <MenuItem x:Name="MenuCloseApp" Header="⏻️ إغلاق التطبيق" FontWeight="SemiBold" 
                              Style="{StaticResource WidgetMenuItem}" Click="MenuCloseApp_Click"/>
                </ContextMenu>
            </Border.ContextMenu>

            <!-- 2-Column Prayer Summary (Exact same height and font as Windows Date & Time) -->
            <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Height="28" IsHitTestVisible="False">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="col1" Width="52" MaxWidth="52"/>
                    <ColumnDefinition x:Name="gap" Width="6" MaxWidth="6"/>
                    <ColumnDefinition x:Name="col2" Width="54" MaxWidth="54"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="14"/>
                    <RowDefinition Height="14"/>
                </Grid.RowDefinitions>

                <!-- Column 0, Row 0: Prayer Name -->
                <TextBlock x:Name="TxtPrayerName" Text="Asr" 
                           Grid.Column="0" Grid.Row="0"
                           FontSize="12" FontWeight="Normal" 
                           LineHeight="14" LineStackingStrategy="BlockLineHeight"
                           FontFamily="Segoe UI Variable Text, Segoe UI, -apple-system, sans-serif"
                           Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"
                           TextAlignment="Center"/>

                <!-- Column 0, Row 1: Prayer Time -->
                <TextBlock x:Name="TxtPrayerTime" Text="15:20" 
                           Grid.Column="0" Grid.Row="1"
                           FontSize="12" FontWeight="Normal" 
                           LineHeight="14" LineStackingStrategy="BlockLineHeight"
                           FontFamily="Segoe UI Variable Text, Segoe UI, -apple-system, sans-serif"
                           Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"
                           TextAlignment="Center"/>

                <!-- Column 2, Row 0: Status Label (After / Left) -->
                <TextBlock x:Name="TxtTimerLabel" Text="After" 
                           Grid.Column="2" Grid.Row="0"
                           FontSize="12" FontWeight="Normal" 
                           LineHeight="14" LineStackingStrategy="BlockLineHeight"
                           FontFamily="Segoe UI Variable Text, Segoe UI, -apple-system, sans-serif"
                           Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"
                           TextAlignment="Center"/>

                <!-- Column 2, Row 1: Timer / Countdown with '+' sign for elapsed -->
                <StackPanel Grid.Column="2" Grid.Row="1"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center" VerticalAlignment="Center"
                            FlowDirection="LeftToRight">
                    <TextBlock x:Name="TxtPlusSign" Text="+" 
                               FontSize="12" FontWeight="Normal" 
                               LineHeight="14" LineStackingStrategy="BlockLineHeight"
                               FontFamily="Segoe UI Variable Text, Segoe UI, -apple-system, sans-serif"
                               Foreground="#FFFFFF" Visibility="Collapsed" Margin="0,0,1,0"/>
                    <TextBlock x:Name="TxtCountdown" Text="00:18" 
                               FontSize="12" FontWeight="Normal" 
                               LineHeight="14" LineStackingStrategy="BlockLineHeight"
                               FontFamily="Segoe UI Variable Text, Segoe UI, -apple-system, sans-serif"
                               Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"
                               TextAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

    </Grid>
</Window>
